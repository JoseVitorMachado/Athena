# Variáveis do docker-compose.yml.
#
# Este arquivo é opcional: sem ele o compose usa os mesmos valores abaixo, que
# servem apenas para desenvolvimento local. Para trocar algo, copie para .env
# (que não é versionado) e edite:
#
#   cp .env.example .env
#
# Nunca coloque senhas reais aqui.

# --- Portas publicadas no host ----------------------------------------------
GATEWAY_PORT=8080
FRONTEND_GESTAO_PORT=4200
FRONTEND_LIVRO_PORT=4300

# --- RabbitMQ ---------------------------------------------------------------
# Usuário e senha não podem conter aspas duplas nem barra invertida.
RABBITMQ_USER=athena
RABBITMQ_PASSWORD=dev_rabbitmq

# --- Bancos: uma instância PostgreSQL por serviço, com credenciais próprias ---
PROJETOS_ACESSO_DB_USER=projetos_acesso
PROJETOS_ACESSO_DB_PASSWORD=dev_projetos_acesso

REQUISITOS_DB_USER=requisitos
REQUISITOS_DB_PASSWORD=dev_requisitos

RASTREABILIDADE_DB_USER=rastreabilidade
RASTREABILIDADE_DB_PASSWORD=dev_rastreabilidade

REVISOES_DB_USER=revisoes
REVISOES_DB_PASSWORD=dev_revisoes

INTEGRACOES_DB_USER=integracoes
INTEGRACOES_DB_PASSWORD=dev_integracoes

IMPACTO_MCP_DB_USER=impacto_mcp
IMPACTO_MCP_DB_PASSWORD=dev_impacto_mcp

# --- Dados de demonstração ---------------------------------------------------
# Com classpath:db/demo os serviços sobem com um projeto e alguns registros de
# exemplo. Para subir com os bancos vazios, use apenas classpath:db/migration.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo

# impacto-mcp: indexa trechos de exemplo do projeto de demonstração.
CARREGAR_DEMO=true
# Inclui margem para o pico de memória ao carregar o modelo de embeddings.
IMPACTO_MCP_MEM_LIMIT=2g

# --- Cliente Python de IA / Ollama -----------------------------------------
# Credenciais de demonstração. Tokens são mantidos em memória, nunca em arquivo.
ATHENA_PROJETO_ID=22222222-2222-4222-8222-222222222222
ATHENA_EMAIL=leitor@athena.dev
ATHENA_SENHA=Athena@2026
LLM_URL=http://ollama:11434
LLM_MODELO=qwen2.5:3b-instruct-q4_K_M
LLM_MODELO_DIGEST=357c53fb659c5076de1d65ccb0b397446227b71a42be9d1603d46168015c9e4b
# Opcional para um proxy autenticado do Ollama; local não requer chave.
LLM_CHAVE=
LLM_TIMEOUT=20
LLM_TENTATIVAS=2
LLM_BACKOFF=2
LLM_MAX_TOKENS=512
LLM_CONTEXTO=4096
RAG_LIMITE=5
# Referência histórica GPT-4.1 mini, USD por milhão de tokens; não chama essa API.
PRECO_ENTRADA_USD_MILHAO=0.40
PRECO_SAIDA_USD_MILHAO=1.60
