# Servidor do cliente Gestão.
#
# - /gestao/  entrega a aplicação Angular (com fallback para o index.html);
# - /api/     é encaminhado ao Gateway, de modo que o navegador fala com uma
#             única origem, como define o livro de arquitetura (§7.3).
#
# ${GATEWAY_URL} é preenchido na subida do container (envsubst da imagem nginx).

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    absolute_redirect off;

    gzip on;
    gzip_types text/css application/javascript application/json;

    location = /saude {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = / {
        return 302 /gestao/;
    }

    location /gestao/ {
        try_files $uri $uri/ /gestao/index.html;
    }

    # O index.html não fica em cache, para o navegador sempre achar o build atual.
    location = /gestao/index.html {
        add_header Cache-Control "no-cache";
    }

    location ~ ^/api/v1/gestao/projetos/[^/]+/assistente/perguntas$ {
        gzip off;
        proxy_read_timeout 110s;
        proxy_pass ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        # A compressão do Nginx enfraquece o ETag usado nas operações com If-Match.
        gzip off;
        proxy_pass ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
