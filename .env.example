# Variáveis do docker-compose.yml.
#
# Este arquivo é opcional: sem ele o compose usa os mesmos valores abaixo, que
# servem apenas para desenvolvimento local. Para trocar algo, copie para .env
# (que não é versionado) e edite:
#
#   cp .env.example .env
#
# Nunca coloque senhas reais aqui.

# --- RabbitMQ ---------------------------------------------------------------
# Usuário e senha não podem conter aspas duplas nem barra invertida.
RABBITMQ_USER=athena
RABBITMQ_PASSWORD=dev_rabbitmq

# --- Bancos: uma instância PostgreSQL por serviço, com credenciais próprias ---
PROJETOS_ACESSO_DB_USER=projetos_acesso
PROJETOS_ACESSO_DB_PASSWORD=dev_projetos_acesso

REQUISITOS_DB_USER=requisitos
REQUISITOS_DB_PASSWORD=dev_requisitos

RASTREABILIDADE_DB_USER=rastreabilidade
RASTREABILIDADE_DB_PASSWORD=dev_rastreabilidade

REVISOES_DB_USER=revisoes
REVISOES_DB_PASSWORD=dev_revisoes

INTEGRACOES_DB_USER=integracoes
INTEGRACOES_DB_PASSWORD=dev_integracoes

IMPACTO_MCP_DB_USER=impacto_mcp
IMPACTO_MCP_DB_PASSWORD=dev_impacto_mcp
